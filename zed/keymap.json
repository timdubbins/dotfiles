// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: Open Default Keymap`
// from the command palette.
[
  {
    "context": "VimControl && !menu",
    "bindings": {
      "shift-h": "vim::StartOfLine",
      "shift-l": "vim::EndOfLine",
      "shift-k": "vim::StartOfParagraph",
      "shift-j": "vim::EndOfParagraph",
      "tab": "vim::Matching",
      "shift-ctrl-k": "editor::MoveLineUp",
      "shift-ctrl-j": "editor::MoveLineDown",
      "ctrl-j": "editor::NewlineBelow",
      "ctrl-k": "editor::NewlineAbove",
      "cmd-h": "editor::JoinLines",
      "f f": "file_finder::Toggle"
    }
  },
  {
    "context": "VimControl && !menu && vim_mode != operator",
    "bindings": {
      "space w": "vim::NextSubwordStart",
      "space b": "vim::PreviousSubwordStart",
      "space e": "vim::NextSubwordEnd"
      // "g e": "vim::PreviousSubwordEnd"
    }
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "shift-s": [
        "vim::PushOperator",
        {
          "AddSurrounds": {}
        }
      ]
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      // "f f": "file_finder::Toggle"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      // "j k": ["workspace::SendKeystrokes", "escape"]
    }
  }
]
